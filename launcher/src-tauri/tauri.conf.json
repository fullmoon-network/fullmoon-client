{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fullmoon",
  "version": "1.2.0",
  "identifier": "dev.fullmoon.launcher",
  "mainBinaryName": "fullmoon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fullmoon",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#080A12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Fullmoon",
    "category": "Game",
    "shortDescription": "풀문 네트워크 전용 마인크래프트 런처",
    "longDescription": "풀문 네트워크의 로비와 야생 서버에 들어가기 위한 마인크래프트 런처예요. 게임과 인게임 모드를 함께 설치하고 실행해 줘요.",
    "targets": ["nsis"],
    "resources": ["resources/mods/*.jar"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
