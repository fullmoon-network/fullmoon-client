  "cssDensity": {
    "$comment": "CSS px per GUI px in the launcher. Space doubles, as a 1280-wide window sits at GUI scale 2. Type takes one and a half. Sizes round to whole px.",
    "space": 2,
    "type": 1.5
  },
  "space": {
    "$comment": "4-unit base in GUI px; only the hairline steps are 1 and 2.",
    "hair": 1,
    "tight": 2,
    "snug": 4,
    "base": 6,
    "cozy": 8,
    "loose": 12,
    "gutter": 16,
    "section": 24,
    "bay": 32,
    "field": 48
  },
  "size": {
    "$comment": "Fixed heights and widths of the glass components, GUI px. The 640×360 GUI is the design size; the menu panel is 512 wide. Rows are taller than the concept mockup's on purpose — a row is a click target for a mouse and a stop for a controller, and the gliding highlight needs room to read as a shape. The *Mock values are the concept mockup's own, kept only so the two spacings can be photographed side by side.",
    "panelW": 512,
    "panelH": 316,
    "mockPanelH": 300,
    "edge": 24,
    "header": 28,
    "row": 40,
    "rowOne": 28,
    "rowMock": 36,
    "rowOneMock": 24,
    "facts": 36,
    "factsMock": 40,
    "button": 20,
    "actionRow": 20,
    "keycap": 11,
    "icon": 16,
    "detail": 176,
    "hint": 14,
    "cell": 20,
    "cellGap": 2,
    "card": 220,
    "cardH": 44,
    "hotbar": 22,
    "hudChip": 16,
    "hudKey": 14,
    "sidebar": 132,
    "sidebarTop": 100,
    "routeRow": 24,
    "routeRowMock": 20,
    "compass": 44,
    "reel": 14,
    "pocket": 14
  },
  "radius": {
    "$comment": "Glass is square. Only what is round in the world is round — dots, knobs, rings, the moon — and a keycap's corner is one pixel because a hard corner on an 11 px cap reads as a tile.",
    "none": 0,
    "sm": 0,
    "md": 0,
    "lg": 0,
    "key": 1,
    "mouse": 3,
    "round": 999
  },
  "stroke": {
    "hair": 1,
    "focus": 2,
    "bar": 2,
    "glyph": 1.5
  },
  "type": {
    "$comment": "Two faces: Pretendard carries every UI role, Hahmlet carries the mark, the display verdict and titles. Hangul is never set below 9 px — micro is Latin and digits only, and Typeset promotes a Hangul string out of it. Each role is a baked TTF provider per GUI scale (id + _x2/_x3/_x4), so a glyph is rasterised at exactly the size it is drawn at.",
    "mark": {
      "font": "fullmoon:mark",
      "px": 28,
      "leading": 32,
      "family": "serif",
      "weight": 700,
      "face": "Fullmoon Serif Bold"
    },
    "display": {
      "font": "fullmoon:display",
