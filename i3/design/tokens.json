  "typeAliases": {
    "$comment": "Launcher CSS still asks for the old role names until its redesign; each alias emits a second custom property pointing at the new role.",
    "wordmark": "mark",
    "heading": "title",
    "bodyStrong": "strong",
    "label": "micro"
  },
  "motion": {
    "$comment": "Transform and opacity only. Position and size glide on a critically damped spring — no overshoot, frame-rate independent, retargetable mid-flight — and colour crossfades on the eased durations. reduceMotion collapses every duration to a crossfade and snaps every spring.",
    "duration": {
      "instant": 0,
      "fast": 90,
      "base": 140,
      "slow": 220,
      "open": 160,
      "close": 90,
      "nudge": 220,
      "reveal": 1200,
      "reduced": 120,
      "flash": 260,
      "verdict": 120
    },
    "easing": {
      "out": [
        0.16,
        1.0,
        0.3,
        1.0
      ],
      "in": [
        0.7,
        0.0,
        0.84,
        0.0
      ],
      "inOut": [
        0.83,
        0.0,
        0.17,
        1.0
      ]
    },
    "spring": {
      "$comment": "response is the period in seconds of the undamped spring; dampingFraction 1 is critically damped. A glide of 0.16 s reaches 95% of the way in about 150 ms.",
      "glide": {
        "response": 0.16,
        "dampingFraction": 1.0
      },
      "lift": {
        "response": 0.14,
        "dampingFraction": 1.0
      },
      "scroll": {
        "response": 0.2,
        "dampingFraction": 1.0
      }
    }
  },
  "sound": {
    "$comment": "UI cues are original, synthesised for Fullmoon (design/make-ui-sounds.py). Volume is the default of the client's own UI-sound setting, on top of the master slider. focusIntervalMs rate-limits the focus tick under key repeat; focusPitchJitter is the random pitch spread on repeated ticks so a run of them does not machine-gun.",
    "volume": 0.5,
    "focusIntervalMs": 45,
    "focusPitchJitter": 0.04
  },
  "layer": {
    "$comment": "Six named levels. An arbitrary z-index is a tell that nobody owned the stacking order.",
    "ground": 0,
    "content": 100,
    "rail": 200,
    "overlay": 300,
    "popover": 400,
    "toast": 500
  }
}
